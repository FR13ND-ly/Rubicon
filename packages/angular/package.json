{
  "name": "@rubicon/angular",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "build.mjs",
    "build-options.mjs"
  ],
  "exports": {
    "./build": "./build.mjs",
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration.mjs"
  },
  "peerDependencies": {
    "@angular/common": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/platform-server": "22.2.2",
    "@angular/router": "22.2.2",
    "@angular/ssr": "22.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
